# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
# Variables marked (required) make `docker compose` fail if they are empty.

# Public port of the load balancer (terminate TLS in front of it).
HTTP_PORT=80

# API
API_REPLICAS=2
API_TAG=latest
LOG_LEVEL=info
GAME_INITIAL_LIVES=3
GAME_FINISHED_TTL=10m
GAME_IDLE_TTL=2h
SHUTDOWN_TIMEOUT=10s

# Sessions (required): a long random string, identical for every replica.
# e.g. openssl rand -base64 48
SESSION_SECRET=
# Keep true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=true
# Only if the UI is served from another origin of the same site.
CORS_ALLOWED_ORIGINS=

# OIDC (required in practice): without it, identity comes from client headers.
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://auth.example.com/realms/quizz
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://quiz.example.com/api/auth/callback
OIDC_FRONTEND_URL=https://quiz.example.com
OIDC_ROLE_CLAIM=role
OIDC_ADMIN_ROLE=admin

# Postgres (password required)
POSTGRES_USER=quizz
POSTGRES_PASSWORD=
POSTGRES_DB=quizz

# Dragonfly (password required)
REDIS_PASSWORD=
DRAGONFLY_MAXMEMORY=1gb
DRAGONFLY_THREADS=2
