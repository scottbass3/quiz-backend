# HTTP
HTTP_PORT=8080
HTTP_ADDR=:8080

# PostgreSQL
POSTGRES_USER=quizz
POSTGRES_PASSWORD=quizz
POSTGRES_DB=quizz
POSTGRES_PORT=5432
DATABASE_URL=postgres://quizz:quizz@localhost:5432/quizz?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# App
LOG_LEVEL=info          # debug | info | warn | error
GAME_INITIAL_LIVES=3
SHUTDOWN_TIMEOUT=10s

# Session (required — change before production)
SESSION_SECRET=dev-secret-change-in-production

# OIDC authentication (optional — set OIDC_ENABLED=true to activate)
# When disabled, identity is simulated via X-Debug-Actor-* headers.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://your-provider.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_FRONTEND_URL=http://localhost:5173
# Role mapping: OIDC_ROLE_CLAIM is the token claim, OIDC_ADMIN_ROLE is its "admin" value.
OIDC_ROLE_CLAIM=role
OIDC_ADMIN_ROLE=admin
